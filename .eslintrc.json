{
  "root": true,
  "env": { "browser": true, "es2022": true },
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module",
    "ecmaFeatures": { "jsx": true }
  },
  "rules": {
    "no-restricted-syntax": [
      "error",
      {
        "selector": "Literal[value=/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{2B00}-\\u{2BFF}]/u]",
        "message": "Do not use emoji in code. Use a custom SVG mood icon or a Phosphor icon instead."
      },
      {
        "selector": "JSXText[value=/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{2B00}-\\u{2BFF}]/u]",
        "message": "Do not use emoji in JSX. Use a custom SVG mood icon or a Phosphor icon instead."
      },
      {
        "selector": "TemplateElement[value.raw=/[\\u{1F300}-\\u{1FAFF}\\u{2600}-\\u{27BF}\\u{2B00}-\\u{2BFF}]/u]",
        "message": "Do not use emoji in template strings. Use a custom SVG mood icon or a Phosphor icon instead."
      }
    ]
  },
  "ignorePatterns": ["dist", "node_modules", "*.config.js", "*.config.ts"]
}
